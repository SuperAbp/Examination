@inherits ExamComponentBase
@attribute [Authorize(Policy = ExamPermissions.Questions.Default)]
@page "/question-management/questions"
@using System.Threading
@using SuperAbp.Exam.Admin.QuestionManagement.Questions
@using SuperAbp.Exam.Admin.QuestionManagement.QuestionBanks
@using SuperAbp.Exam.Admin.KnowledgePoints
@using SuperAbp.Exam.Options
@inject IQuestionAdminAppService QuestionAppService
@inject IQuestionBankAdminAppService QuestionBankAppService
@inject IKnowledgePointAdminAppService KnowledgePointAppService
@inject IOptionAppService OptionAppService
@inject IAuthorizationService Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">@L["Menu:Questions"]</MudText>

<MudCard Elevation="0">
    <MudCardContent Class="pb-3">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="filterContent"
                          Label="@L["QuestionContent"]"
                          T="string"
                          Immediate="true"
                          OnKeyUp="FilterOnKeyUp"
                          Style="min-width: 220px;" />
            <MudSelect @bind-Value="filterQuestionType"
                       T="int?"
                       Label="@L["QuestionType"]"
                       Clearable="true"
                       CloseOnSelect="true"
                       Style="min-width: 160px;">
                @foreach (var questionType in questionTypes)
                {
                    <MudSelectItem Value="@((int?)questionType.Key)">@L[$"QuestionType:{questionType.Key}"]</MudSelectItem>
                }
            </MudSelect>
            <MudSelect @bind-Value="filterQuestionBankId"
                       T="Guid?"
                       Label="@L["QuestionBank"]"
                       Clearable="true"
                       SearchBox="true"
                       CloseOnSelect="true"
                       Style="min-width: 200px;">
                @foreach (var questionBank in questionBanks)
                {
                    <MudSelectItem Value="@((Guid?)questionBank.Id)">@questionBank.Title</MudSelectItem>
                }
            </MudSelect>
            <MudSelect @bind-Value="filterKnowledgePointId"
                       T="Guid?"
                       Label="@L["KnowledgePoint"]"
                       Clearable="true"
                       SearchBox="true"
                       CloseOnSelect="true"
                       Style="min-width: 200px;">
                @foreach (var knowledgePoint in knowledgePointOptions)
                {
                    <MudSelectItem Value="@((Guid?)knowledgePoint.Id)">@knowledgePoint.Label</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync">
                @L["Search"]
            </MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ResetAsync">
                @L["Reset"]
            </MudButton>
        </MudStack>
        <MudStack Row Spacing="1" Class="mt-3">
            @if (CanImport)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Upload"
                           OnClick="GoToImportAsync">
                    @L["Import"]
                </MudButton>
            }
            @if (CanCreate)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="GoToCreateAsync">
                    @L["NewQuestion"]
                </MudButton>
            }
        </MudStack>
    </MudCardContent>
    <MudCardContent>
        <MudDataGrid @key="gridKey"
                     @ref="_grid"
                     T="QuestionListDto"
                     ServerData="LoadServerDataAsync"
                     Hover="true"
                     Striped="true"
                     LoadingProgressColor="Color.Primary"
                     RowsPerPage="10">
            <Columns>
                <PropertyColumn Property="x => x.QuestionBank" Title="@L["QuestionBank"]" />
                <TemplateColumn Title="@L["QuestionType"]" Sortable="false">
                    <CellTemplate Context="context">
                        @L[$"QuestionType:{context.Item.QuestionType}"]
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Content" Title="@L["QuestionContent"]" />
                <TemplateColumn Title="@L["KnowledgePoint"]" Sortable="false">
                    <CellTemplate Context="context">
                        @(context.Item.KnowledgePoints is { Count: > 0 } ? string.Join("、", context.Item.KnowledgePoints) : string.Empty)
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CreationTime" Title="@L["CreationTime"]" />
                <TemplateColumn Title="@L["Actions"]" Sortable="false">
                    <CellTemplate Context="context">
                        @if (CanUpdate)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Info"
                                           OnClick="() => GoToEditAsync(context.Item)" />
                        }
                        @if (CanDelete)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="() => DeleteAsync(context.Item)" />
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="QuestionListDto"
                                  PageSizeOptions="new[] { 10, 20, 30, 40, 50 }" />
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private MudDataGrid<QuestionListDto> _grid = default!;
    private int gridKey;
    private string? filterContent;
    private int? filterQuestionType;
    private Guid? filterQuestionBankId;
    private Guid? filterKnowledgePointId;
    private bool CanCreate { get; set; }
    private bool CanUpdate { get; set; }
    private bool CanDelete { get; set; }
    private bool CanImport { get; set; }

    private Dictionary<int, string> questionTypes = [];
    private List<QuestionBankListDto> questionBanks = [];
    private List<KnowledgePointOption> knowledgePointOptions = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CanCreate = (await Authorization.AuthorizeAsync(authState.User, ExamPermissions.Questions.Create)).Succeeded;
        CanUpdate = (await Authorization.AuthorizeAsync(authState.User, ExamPermissions.Questions.Update)).Succeeded;
        CanDelete = (await Authorization.AuthorizeAsync(authState.User, ExamPermissions.Questions.Delete)).Succeeded;
        CanImport = (await Authorization.AuthorizeAsync(authState.User, ExamPermissions.Questions.Import)).Succeeded;

questionTypes = await OptionAppService.GetQuestionTypes();
        var banks = await QuestionBankAppService.GetListAsync(new GetQuestionBanksInput
        {
            SkipCount = 0,
            MaxResultCount = 100
        });
        questionBanks = banks.Items.ToList();

        var knowledgePoints = await KnowledgePointAppService.GetAllAsync(new GetKnowledgePointsInput());
        knowledgePointOptions = FlattenKnowledgePoints(knowledgePoints.Items, 0);
    }

    private async Task<GridData<QuestionListDto>> LoadServerDataAsync(GridState<QuestionListDto> state, CancellationToken cancellationToken)
    {
        var input = new GetQuestionsInput
        {
            Content = filterContent,
            QuestionType = filterQuestionType,
            QuestionBankIds = filterQuestionBankId.HasValue ? [filterQuestionBankId.Value] : [],
            KnowledgePointId = filterKnowledgePointId,
            SkipCount = state.Page * state.PageSize,
            MaxResultCount = state.PageSize,
            Sorting = "Id Desc"
        };

        if (state.SortDefinitions.Count > 0)
        {
            var sort = state.SortDefinitions.First();
            input.Sorting = sort.SortBy + " " + (sort.Descending ? "Desc" : "Asc");
        }

        var result = await QuestionAppService.GetListAsync(input);
        return new GridData<QuestionListDto>
        {
            Items = result.Items,
            TotalItems = (int)result.TotalCount
        };
    }

    private async Task SearchAsync()
    {
        if (_grid != null)
        {
            await _grid.ReloadServerData();
        }
    }

    private async Task FilterOnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task ResetAsync()
    {
        filterContent = null;
        filterQuestionType = null;
        filterQuestionBankId = null;
        filterKnowledgePointId = null;
        gridKey++;
        await SearchAsync();
    }

    private Task GoToCreateAsync()
    {
        Navigation.NavigateTo("/question-management/questions/edit");
        return Task.CompletedTask;
    }

    private Task GoToEditAsync(QuestionListDto question)
    {
        Navigation.NavigateTo($"/question-management/questions/edit/{question.Id}");
        return Task.CompletedTask;
    }

    private Task GoToImportAsync()
    {
        Navigation.NavigateTo("/question-management/questions/import");
        return Task.CompletedTask;
    }

    private async Task DeleteAsync(QuestionListDto question)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            L["Tips"],
            string.Format(L["AreYouSureToDeleteNamed"], Truncate(question.Content, 30)),
            yesText: L["Delete"],
            cancelText: L["Cancel"]);

        if (confirmed == true)
        {
            await QuestionAppService.DeleteAsync(question.Id);
            Snackbar.Add(L["DeletedSuccessfully"], Severity.Success);
            await SearchAsync();
        }
    }

    private static string Truncate(string value, int maxLength)
    {
        return value.Length <= maxLength ? value : value[..maxLength] + "…";
    }

    private List<KnowledgePointOption> FlattenKnowledgePoints(IEnumerable<KnowledgePointNodeDto> nodes, int level)
    {
        var result = new List<KnowledgePointOption>();
        foreach (var node in nodes)
        {
            var label = string.Concat(Enumerable.Repeat("　", level)) + node.Name;
            result.Add(new KnowledgePointOption(node.Id, label));
            if (node.Children is { Count: > 0 })
            {
                result.AddRange(FlattenKnowledgePoints(node.Children, level + 1));
            }
        }

        return result;
    }

    private sealed record KnowledgePointOption(Guid Id, string Label);
}
