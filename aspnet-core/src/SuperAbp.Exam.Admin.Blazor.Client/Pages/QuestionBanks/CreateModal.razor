@using Microsoft.Extensions.Localization
@using SuperAbp.Exam.Localization
@inject IStringLocalizer<ExamResource> L

<Modal Title="@L["NewQuestionBank"]"
       Visible="@_visible"
       ConfirmLoading="@_submitLoading"
       OnOk="SaveAsync"
       OnCancel="Close">
    <Form @ref="CreateForm"
          Name="update-form"
          Layout="@FormLayout.Vertical"
          Model="@QuestionBank">
        <FormItem Label="@L["Title"]">
            <Input @bind-Value="@context.Title" />
        </FormItem>
        <FormItem Label="@L["Remark"]">
            <TextArea Rows="4" @bind-Value="@context.Remark" />
        </FormItem>
    </Form>
</Modal>
