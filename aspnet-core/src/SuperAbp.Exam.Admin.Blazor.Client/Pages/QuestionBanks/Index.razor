@page "/question-banks"
@using Microsoft.Extensions.Localization
@using SuperAbp.Exam.Admin.Blazor.Client.Utils
@using SuperAbp.Exam.Admin.QuestionManagement.QuestionBanks
@using SuperAbp.Exam.Localization
@using SuperAbp.Exam.Permissions
@using Volo.Abp.AspNetCore.Components.Notifications
@inherits CustomerTablePageBase<IQuestionBankAdminAppService, QuestionBankListDto, Guid, GetQuestionBanksInput, QuestionBankListDto>
@inject IAuthorizationService AuthorizationService
@inject IStringLocalizer<ExamResource> L

<AbpPageHeader Title="@L["QuestionBanks"]" BreadcrumbItems="@BreadcrumbItems" Toolbar="@Toolbar" />
<div class="page-content">
    <Form Class="search-form" @ref="SearchForm" Layout="@FormLayout.Inline" Model="@GetListInput">
        <FormItem Label="@L["Title"]">
            <Input @bind-Value="@context.Title" />
        </FormItem>
        <FormItem>
            <Button Type="@ButtonType.Primary" HtmlType="submit" OnClick="SearchEntitiesAsync">
                @L["Search"]
            </Button>
            <Button HtmlType="submit" OnClick="ClearSearchAsync">
                @L["Clear"]
            </Button>
        </FormItem>
    </Form>
    <AbpExtensibleDataGrid TItem="QuestionBankListDto"
                           Data="@Entities"
                           OnChange="@OnDataGridReadAsync"
                           TotalItems="@TotalCount"
                           PageSize="@PageSize"
                           CurrentPage="@CurrentPage"
                           Columns="@QuestionBankTableColumns">
    </AbpExtensibleDataGrid>
</div>
@if(HasCreatePermission)
{
    <CreateModal @ref="CreateModal" OnSaveSuccess="@OnSaveSuccessAsync" />
}
@if(HasUpdatePermission)
{
    <UpdateModal @ref="UpdateModal" OnSaveSuccess="@OnSaveSuccessAsync" />
}