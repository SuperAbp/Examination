@inherits ExamComponentBase
@attribute [Authorize(Policy = ExamPermissions.Papers.Default)]
@page "/paper-management/papers"
@using System.Threading
@using SuperAbp.Exam.Admin.PaperManagement.Papers
@inject IPaperAdminAppService PaperAppService
@inject IAuthorizationService Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">@L["Menu:Papers"]</MudText>

<MudCard Elevation="0">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="filterName"
                              Label="@L["Name"]"
                              T="string"
                              Immediate="true"
                              OnKeyUp="FilterOnKeyUp"
                              Style="min-width: 220px;" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync">
                    @L["Search"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="ResetAsync">
                    @L["Reset"]
                </MudButton>
            </MudStack>
        </CardHeaderContent>
        <CardHeaderActions>
            @if (CanCreate)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="GoToCreateAsync">
                    @L["NewPaper"]
                </MudButton>
            }
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudDataGrid @ref="_grid"
                     T="PaperListDto"
                     ServerData="LoadServerDataAsync"
                     Hover="true"
                     Striped="true"
                     LoadingProgressColor="Color.Primary"
                     RowsPerPage="10">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="@L["Name"]" />
                <PropertyColumn Property="x => x.Score" Title="@L["Score"]" />
                <TemplateColumn Title="@L["ManualReview"]" Sortable="false">
                    <CellTemplate Context="context">
                        @(context.Item.ManualReview ? L["Yes"] : L["No"])
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Actions"]" Sortable="false">
                    <CellTemplate Context="context">
                        @if (CanUpdate)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Info"
                                           OnClick="() => GoToEditAsync(context.Item)" />
                        }
                        @if (CanDelete)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="() => DeleteAsync(context.Item)" />
                        }
                        @if (CanCreateExam)
                        {
                            <MudTooltip Text="@L["NewExam"]">
                                <MudIconButton Icon="@Icons.Material.Filled.PostAdd"
                                               Size="Size.Small"
                                               Color="Color.Success"
                                               OnClick="() => GoToCreateExamAsync(context.Item)" />
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="PaperListDto"
                                  PageSizeOptions="new[] { 10, 20, 30, 40, 50 }" />
            </PagerContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@code {
    private MudDataGrid<PaperListDto> _grid = default!;
    private string? filterName;
    private bool CanCreate { get; set; }
    private bool CanUpdate { get; set; }
    private bool CanDelete { get; set; }
    private bool CanCreateExam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CanCreate = (await Authorization.AuthorizeAsync(authState.User, ExamPermissions.Papers.Create)).Succeeded;
        CanUpdate = (await Authorization.AuthorizeAsync(authState.User, ExamPermissions.Papers.Update)).Succeeded;
        CanDelete = (await Authorization.AuthorizeAsync(authState.User, ExamPermissions.Papers.Delete)).Succeeded;
        CanCreateExam = (await Authorization.AuthorizeAsync(authState.User, ExamPermissions.Exams.Create)).Succeeded;
    }

    private async Task<GridData<PaperListDto>> LoadServerDataAsync(GridState<PaperListDto> state, CancellationToken cancellationToken)
    {
        var input = new GetPapersInput
        {
            Name = filterName,
            SkipCount = state.Page * state.PageSize,
            MaxResultCount = state.PageSize,
            Sorting = "Id Desc"
        };

        if (state.SortDefinitions.Count > 0)
        {
            var sort = state.SortDefinitions.First();
            input.Sorting = sort.SortBy + " " + (sort.Descending ? "Desc" : "Asc");
        }

        var result = await PaperAppService.GetListAsync(input);
        return new GridData<PaperListDto>
        {
            Items = result.Items,
            TotalItems = (int)result.TotalCount
        };
    }

    private async Task SearchAsync()
    {
        if (_grid != null)
        {
            await _grid.ReloadServerData();
        }
    }

    private async Task FilterOnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task ResetAsync()
    {
        filterName = null;
        await SearchAsync();
    }

    private async Task GoToCreateAsync()
    {
        var parameters = new DialogParameters<PaperTypeDialog>();
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<PaperTypeDialog>(L["NewPaper"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: int paperType })
        {
            Navigation.NavigateTo($"/paper-management/papers/create/{paperType}");
        }
    }

    private Task GoToEditAsync(PaperListDto paper)
    {
        Navigation.NavigateTo($"/paper-management/papers/edit/{paper.Id}/{paper.PaperType}");
        return Task.CompletedTask;
    }

    private Task GoToCreateExamAsync(PaperListDto paper)
    {
        Navigation.NavigateTo($"/exam-management/exams/create?paperId={paper.Id}");
        return Task.CompletedTask;
    }

    private async Task DeleteAsync(PaperListDto paper)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            L["Tips"],
            string.Format(L["AreYouSureToDeleteNamed"], paper.Name),
            yesText: L["Delete"],
            cancelText: L["Cancel"]);

        if (confirmed == true)
        {
            await PaperAppService.DeleteAsync(paper.Id);
            Snackbar.Add(L["DeletedSuccessfully"], Severity.Success);
            await SearchAsync();
        }
    }
}
