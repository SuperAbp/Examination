@page "/exam/start/{id:guid}"

@if (_loading)
{
    <div style=" text-align: center;margin: 50px 0;">
        <Spin />
    </div>
}
else
{
    <GridRow Gutter="16">
        <GridCol Span="4">
            <Affix OffsetTop="10">
                <QuestionNumber CurrentId="_currentId"
                                Numbers="_questions"
                                AnswerIds="_answerIds"
                                OnChanged="ChangeQuestion"></QuestionNumber>
            </Affix>
        </GridCol>
        <GridCol Span="16">
            <Card class="question-content">
                <ChildContent>
                    @if (_userExam.AnswerMode == AnswerMode.Single)
                    {
                        <Single @ref="_singleComponent"
                                QuestionAnswerStorageKey="@_questionAnswerStorageKey"
                                Questions="_sections.SelectMany(s=>s.Questions).ToArray()"
                                QuestionIds="_questionIds"
                                OnAnswered="OnAnswered"
                                OnQuestionChanged="ChangeQuestion" />
                    }
                    else
                    {
                        <Full @ref="_fullComponent"
                              UserExamId="Id"
                              QuestionAnswers="@_questionAnswers"
                              QuestionAnswerStorageKey="@_questionAnswerStorageKey"
                              Sections="_sections"
                              OnAnswered="OnAnswered" />
                    }
                </ChildContent>
            </Card>
        </GridCol>
        <GridCol Span="4">
            <Affix OffsetTop="10">
                <Card style="text-align: center;">
                    <ChildContent>                        
                        <CountDown Title="@L["TimeLeft"]" Value="@_userExam.EndTime" ValueStyle="color:red; font-size: 22px" OnFinish="SubmitPaperAsync" />
                        <Divider Type="DividerType.Horizontal" />
                        <Button AutoLoading Type="@ButtonType.Primary" OnClick="SubmitPaperAsync" style="width:100%">提交试卷</Button>
                    </ChildContent>
                </Card>
            </Affix>
        </GridCol>
    </GridRow>
}

@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Configuration
@using SuperAbp.Exam.Blazor.Pages.Exam.Start.Components
@using SuperAbp.Exam.ExamManagement.UserExams
@using SuperAbp.Exam.Blazor.Model
@using SuperAbp.Exam.Localization
@using Microsoft.Extensions.Localization
@using SuperAbp.Exam.ExamManagement.Exams
@using Volo.Abp.Http.Client
@using Single = SuperAbp.Exam.Blazor.Pages.Exam.Start.Components.Single
@using Volo.Abp.ObjectMapping
@using static SuperAbp.Exam.Blazor.Model.UserExamSectionViewModel.UserExamQuestionViewModel
@using static SuperAbp.Exam.Blazor.Model.UserExamSectionViewModel
@using static SuperAbp.Exam.ExamManagement.UserExams.UserExamDetailDto.SectionDto
@using static SuperAbp.Exam.ExamManagement.UserExams.UserExamDetailDto
@inject NavigationManager Navigation
@inject IAccessTokenProvider AccessTokenProvider
@inject IStringLocalizer<ExamResource> L
@inject IUserExamAppService UserExamAppService
@inject IObjectMapper ObjectMapper
@inject IConfiguration Configuration
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@code {
    [Parameter]
    public Guid Id { get; set; }

    private Dictionary<Guid, string> _questionAnswers = [];

    bool _loading = true;
    List<UserExamSectionViewModel> _sections = [];
    Dictionary<int, int> _questionTypes = new();
    readonly List<QuestionNumberVo> _questions = [];
    UserExamDetailDto _userExam;
    Guid _currentId;

    Guid[] _questionIds = [];
    private string _questionAnswerStorageKey;

    private Single _singleComponent;
    private Full _fullComponent;

    // 新增：答过的题目ID列表
    private readonly List<Guid> _answerIds = new();


    protected override async Task OnInitializedAsync()
    {
        _questionAnswerStorageKey = $"question_answers_{Id}";
        try
        {
            _userExam = await UserExamAppService.GetAsync(Id);
        }
        catch (AbpRemoteCallException e)
        {
            if (e.HttpStatusCode == 404)
            {
                Navigation.NavigateTo("/exam");
            }
            return;
        }

        List<QuestionAnswerItem> answerItems = await LocalStorage.GetItemAsync<List<QuestionAnswerItem>>(_questionAnswerStorageKey) ?? [];
        if (answerItems.Count > 0)
        {
            foreach (var item in answerItems)
            {
                _questionAnswers.Add(item.QuestionId, item.Answer);
                if (!_answerIds.Contains(item.QuestionId))
                {
                    _answerIds.Add(item.QuestionId);
                }
            }
        }

        foreach (var section in _userExam.Sections)
        {
            QuestionNumberVo vo = new QuestionNumberVo()
            {
                SectionTitle = section.Title,
                TotalScore = section.TotalScore,
            };
            UserExamSectionViewModel sectionVo = ObjectMapper.Map<SectionDto, UserExamSectionViewModel>(section);
            List<QuestionNumberVo.QuestionIndex> questionIndexes = [];            
            foreach (var q in section.Questions)
            {
                questionIndexes.Add(new QuestionNumberVo.QuestionIndex()
                {
                    QuestionId = q.Id,
                    Score = q.QuestionScore
                });
                vo.Questions = questionIndexes;

            }
            _sections.Add(sectionVo);
            _questions.Add(vo);
        }

        _questionIds = _questions.SelectMany(q => q.Questions.Select(i => i.QuestionId)).ToArray();
        _currentId = _questions[0].Questions[0].QuestionId;

        (await AccessTokenProvider.RequestAccessToken()).TryGetToken(out var accessToken);
        string signalRUrl = Configuration["SignalRUrl"] ?? "";
        HubConnection hubConnection = new HubConnectionBuilder()
            .WithUrl(signalRUrl.EnsureEndsWith('/') + "signalr-hubs/progress", options =>
            {
                options.AccessTokenProvider = () => Task.FromResult(accessToken!.Value);
            })
            .Build();

        hubConnection.On("Submitted", async () =>
        {
            // TODO: 状态已更改，无法提交。需要解决
            await SubmitPaperAsync();
        });

        await hubConnection.StartAsync();
        _loading = false;
    }
    protected IReadOnlyList<QuestionAnswerViewModel> ToQuestionAnswerViewModels(IEnumerable<UserExamQuestionAnswerViewModel> answers)
    {
        return answers
            .Select(qa => new QuestionAnswerViewModel
            {
                Id = qa.Id,
                Content = qa.Content,
                Right = false
            }).ToArray();
    }

    public virtual async Task SubmitPaperAsync()
    {
        List<QuestionAnswerItem> answerItems = await LocalStorage.GetItemAsync<List<QuestionAnswerItem>>(_questionAnswerStorageKey) ?? [];
        await UserExamAppService.FinishedAsync(Id, answerItems.Select(a => new UserExamAnswerDto
        {
            QuestionId = a.QuestionId,
            Answers = a.Answer
        }).ToList());
        await LocalStorage.RemoveItemAsync(_questionAnswerStorageKey);
        Navigation.NavigateTo("/exam/result");
    }

    public async Task ChangeQuestion(Guid id)
    {
        _currentId = id;
        if (_userExam.AnswerMode == AnswerMode.Single)
        {
            await _singleComponent.ShowQuestionAsync(id);
        }
        else
        {
            await _fullComponent.ShowQuestionAsync(id);
        }
    }

    public void OnAnswered(Guid id)
    {
        if (!_answerIds.Contains(id))
        {
            _answerIds.Add(id);
            StateHasChanged();
        }
    }

    protected virtual void GoDetail()
    {
        Navigation.NavigateTo($"/exam");
    }
}